# Don't count SVGs as code on GitHub — they are documentation.
*.svg linguist-detectable=false linguist-documentation=true

# PNGs are binary. (This is the default but be explicit.)
*.png binary

# Verifier output is regenerated by .verify/verify.ts and is ephemeral
# anyway, but if it ever does get staged we want the diff to be obvious.
.verify/*.png binary
.verify/*.gif binary
