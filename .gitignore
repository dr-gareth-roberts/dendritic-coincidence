# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Verifier output artefacts (PNGs, GIFs, intermediate frames).
# The verifier scripts themselves (.verify/*.ts) stay tracked so the
# verification flow is reproducible from a fresh clone.
.verify/*.png
.verify/*.gif
.verify/gif-frames/

# Docs/screenshots are the canonical tracked copies — the README links to
# them. The verifier writes fresh copies to .verify/ on every run; we
# don't want those in git, but we DO want the stable doc screenshots.
!docs/screenshots/*.png
